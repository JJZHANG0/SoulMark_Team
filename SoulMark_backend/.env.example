SOULMARK_ENVIRONMENT=development
SOULMARK_DATABASE_URL=postgresql+psycopg://soulmark:soulmark_local@localhost:5432/soulmark
SOULMARK_JWT_SECRET=replace-with-a-long-random-secret
SOULMARK_JWT_ACCESS_TOKEN_MINUTES=43200
SOULMARK_QWEN_API_KEY=replace-with-your-dashscope-api-key
SOULMARK_QWEN_REALTIME_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
SOULMARK_QWEN_REALTIME_MODEL=qwen3.5-omni-plus-realtime
SOULMARK_QWEN_VOICE=Ethan
SOULMARK_QWEN_INPUT_TRANSCRIPTION_MODEL=qwen3-asr-flash-realtime
SOULMARK_AVATAR_UPLOAD_DIR=uploads/avatars
SOULMARK_AVATAR_MAX_BYTES=5242880

# 微信开放平台移动应用配置。
SOULMARK_WECHAT_APP_ID=REPLACE_ME_WECHAT_APP_ID
SOULMARK_WECHAT_APP_SECRET=REPLACE_ME_WECHAT_APP_SECRET

# development 只用于自动化测试，不发送真实短信；生产环境启动时会拒绝此配置。
SOULMARK_SMS_PROVIDER=development
SOULMARK_SMS_DEVELOPMENT_CODE=123456
SOULMARK_SMS_CODE_TTL_SECONDS=300
SOULMARK_SMS_RESEND_INTERVAL_SECONDS=60
SOULMARK_SMS_MAX_ATTEMPTS=5

# 阿里云号码认证（PNVS）配置。
SOULMARK_PNVS_SIGN_NAME=REPLACE_ME_PNVS_SIGN_NAME
SOULMARK_PNVS_TEMPLATE_CODE=100001
SOULMARK_PNVS_SCHEME_NAME=
SOULMARK_PNVS_CODE_LENGTH=6

# 普通阿里云短信配置。
SOULMARK_ALIYUN_ACCESS_KEY_ID=REPLACE_ME_ALIYUN_ACCESS_KEY_ID
SOULMARK_ALIYUN_ACCESS_KEY_SECRET=REPLACE_ME_ALIYUN_ACCESS_KEY_SECRET
SOULMARK_ALIYUN_SMS_SIGN_NAME=REPLACE_ME_SMS_SIGN_NAME
SOULMARK_ALIYUN_SMS_TEMPLATE_CODE=REPLACE_ME_SMS_TEMPLATE_CODE
